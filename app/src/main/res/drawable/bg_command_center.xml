<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle carbon fiber texture at ~5% opacity over charcoal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/f1_black"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF"/>
            <stroke android:width="1dp" android:color="#08FFFFFF"/>
        </shape>
    </item>
</layer-list>
